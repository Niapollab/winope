[Unit]
Description=Winope Transparent Gateway Service
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=winope
Image=ghcr.io/sagernet/sing-box:v1.14.3

Network=winope.network:ip=10.67.0.2

DropCapability=ALL
NoNewPrivileges=true

ReadOnly=true
Tmpfs=/tmp:size=16m,mode=1777,noexec,nosuid,nodev

Memory=256M
PidsLimit=100

PodmanArgs=--ipc=none

AddCapability=CAP_NET_ADMIN
AddDevice=/dev/net/tun

Sysctl=net.ipv4.ip_forward=1

Volume=%h/.config/winope/sing-box-config.json:/etc/sing-box/config.json:ro,Z

Entrypoint=/bin/sh
Exec=-c "ip route replace default via 10.67.0.1 && exec sing-box run -c /etc/sing-box/config.json"

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
